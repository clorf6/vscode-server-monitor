        "title": "%command.docker.copyId%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.du.analyze",
        "title": "%command.du.analyze%",
        "category": "%category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "serverMonitor.du.analyzeHome",
        "title": "%command.du.analyzeHome%",
        "category": "%category%",
        "icon": "$(home)"
      },
      {
        "command": "serverMonitor.du.cancel",
        "title": "%command.du.cancel%",
        "category": "%category%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "serverMonitor.du.rescan",
        "title": "%command.du.rescan%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "serverMonitor.du.drillInto",
        "title": "%command.du.drillInto%",
        "category": "%category%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "serverMonitor.du.terminal",
        "title": "%command.du.terminal%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.du.copyPath",
        "title": "%command.du.copyPath%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.du.reveal",
        "title": "%command.du.reveal%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.du.openFolder",
        "title": "%command.du.openFolder%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.watch.remove",
        "title": "%command.watch.remove%",
        "category": "%category%",
        "icon": "$(close)"
      },
      {
        "command": "serverMonitor.watch.clear",
        "title": "%command.watch.clear%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "serverMonitor.gpu.copyIndex",
        "title": "%command.gpu.copyIndex%",
        "category": "%category%",
        "icon": "$(copy)"
      },
      {
        "command": "serverMonitor.du.up",
        "title": "%command.du.up%",
        "category": "%category%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "serverMonitor.freeUp",
        "title": "%command.freeUp%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "serverMonitor.locate",
        "title": "%command.locate%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.quickCommands.run",
        "title": "%command.quickCommands.run%",
        "category": "%category%",
        "icon": "$(zap)"
      },
      {
        "command": "serverMonitor.quickCommands.add",
        "title": "%command.quickCommands.add%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "serverMonitor.quickCommands.remove",
        "title": "%command.quickCommands.remove%",
        "category": "%category%",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "serverMonitor.proc.showMore",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.watch",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.terminalAtCwd",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.openCwd",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.copyPid",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.copyCmd",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.interrupt",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.kill",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.kill9",
          "when": "false"
        },
        {
          "command": "serverMonitor.user.showProcesses",
          "when": "false"
        },
        {
          "command": "serverMonitor.tmux.attach",
          "when": "false"
        },
        {
          "command": "serverMonitor.tmux.peek",
          "when": "false"
        },
        {
          "command": "serverMonitor.tmux.peekTarget",
          "when": "false"
        },
        {
          "command": "serverMonitor.tmux.watch",
          "when": "false"
        },
        {
          "command": "serverMonitor.tmux.rename",
          "when": "false"
        },
        {
          "command": "serverMonitor.tmux.ctrlC",
          "when": "false"
        },
        {
          "command": "serverMonitor.tmux.kill",
          "when": "false"
        },
        {
          "command": "serverMonitor.port.open",
          "when": "false"
        },
        {
          "command": "serverMonitor.port.openInEditor",
          "when": "false"
        },
        {
          "command": "serverMonitor.port.copyUrl",
          "when": "false"
        },
        {
          "command": "serverMonitor.port.kill",
          "when": "false"
        },
        {
          "command": "serverMonitor.disk.terminal",
          "when": "false"
        },
        {
          "command": "serverMonitor.disk.copyPath",
          "when": "false"
        },
        {
          "command": "serverMonitor.docker.start",
          "when": "false"
        },
        {
          "command": "serverMonitor.docker.stop",
          "when": "false"
        },
        {
          "command": "serverMonitor.docker.restart",
          "when": "false"
        },
        {
          "command": "serverMonitor.docker.logs",
          "when": "false"
        },
        {
          "command": "serverMonitor.docker.exec",
          "when": "false"
        },
        {
          "command": "serverMonitor.docker.copyId",
          "when": "false"
        },
        {
          "command": "serverMonitor.du.drillInto",
          "when": "false"
        },
        {
          "command": "serverMonitor.du.terminal",
          "when": "false"
        },
        {
          "command": "serverMonitor.du.copyPath",
          "when": "false"
        },
        {
          "command": "serverMonitor.du.reveal",
          "when": "false"
        },
        {
          "command": "serverMonitor.du.openFolder",
          "when": "false"
        },
        {
          "command": "serverMonitor.watch.remove",
          "when": "false"
        },
        {
          "command": "serverMonitor.proc.clearFilter",
          "when": "serverMonitor.procFiltered"
        },
        {
          "command": "serverMonitor.proc.showAll",
          "when": "serverMonitor.procScope == mine"
        },
        {
          "command": "serverMonitor.proc.showMine",
          "when": "serverMonitor.procScope == all"
        },
        {
          "command": "serverMonitor.proc.treeOn",
          "when": "!serverMonitor.procTree"
        },
        {
          "command": "serverMonitor.proc.treeOff",
          "when": "serverMonitor.procTree"
        },
        {
          "command": "serverMonitor.tmux.new",
          "when": "serverMonitor.tmuxInstalled"
        },
        {
          "command": "serverMonitor.tmux.refreshPeek",
          "when": "resourceScheme == servermon-tmux"
        },
        {
          "command": "serverMonitor.du.cancel",
          "when": "serverMonitor.duScanning"
        },
        {
          "command": "serverMonitor.du.rescan",
          "when": "view.serverMonitor.du.visible"
        },
        {
          "command": "serverMonitor.gpu.copyIndex",
          "when": "false"
        },
        {
          "command": "serverMonitor.locate",
          "when": "false"
        },
        {
          "command": "serverMonitor.quickCommands.remove",
          "when": "false"
        },
        {
          "command": "serverMonitor.du.up",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "serverMonitor.pickGpus",
          "when": "view == serverMonitor.gpus",
          "group": "navigation@1"
        },
        {
          "command": "serverMonitor.copyFreeGpus",
          "when": "view == serverMonitor.gpus",
          "group": "navigation@2"
        },
        {
          "command": "serverMonitor.watchFreeGpus",
          "when": "view == serverMonitor.gpus",
          "group": "navigation@3"
        },
        {
          "command": "serverMonitor.openDashboard",
          "when": "view == serverMonitor.gpus",
          "group": "navigation@9"
        },
        {
          "command": "serverMonitor.proc.filter",
          "when": "view == serverMonitor.processes",
          "group": "navigation@1"
        },
        {
          "command": "serverMonitor.proc.clearFilter",
          "when": "view == serverMonitor.processes && serverMonitor.procFiltered",
          "group": "navigation@2"
        },
        {
          "command": "serverMonitor.proc.showAll",
          "when": "view == serverMonitor.processes && serverMonitor.procScope == mine",
          "group": "navigation@3"
        },
        {
          "command": "serverMonitor.proc.showMine",
          "when": "view == serverMonitor.processes && serverMonitor.procScope == all",
          "group": "navigation@3"
        },
        {
          "command": "serverMonitor.proc.treeOn",
          "when": "view == serverMonitor.processes && !serverMonitor.procTree",
          "group": "navigation@4"
        },
        {
          "command": "serverMonitor.proc.treeOff",
          "when": "view == serverMonitor.processes && serverMonitor.procTree",
          "group": "navigation@4"
        },
        {
          "command": "serverMonitor.proc.sort",
          "when": "view == serverMonitor.processes",
          "group": "navigation@5"
        },
        {
          "command": "serverMonitor.tmux.new",
          "when": "view == serverMonitor.tmux && serverMonitor.tmuxInstalled",
          "group": "navigation@1"
        },
        {
          "command": "serverMonitor.du.analyzeHome",
          "when": "view == serverMonitor.disks",
          "group": "1_du@1"
        },
        {
          "command": "serverMonitor.disk.refresh",
          "when": "view == serverMonitor.disks",
          "group": "navigation@1"
        },
        {
          "command": "serverMonitor.du.analyze",
          "when": "view == serverMonitor.du",
          "group": "navigation@1"
        },
        {
          "command": "serverMonitor.du.cancel",
          "when": "view == serverMonitor.du && serverMonitor.duScanning",
          "group": "navigation@2"
        },
        {
          "command": "serverMonitor.du.rescan",
          "when": "view == serverMonitor.du && !serverMonitor.duScanning",
          "group": "navigation@3"
        },
        {
          "command": "serverMonitor.du.analyzeHome",
          "when": "view == serverMonitor.du",
          "group": "1_du@1"
        },
        {
          "command": "serverMonitor.watchFreeGpus",
          "when": "view == serverMonitor.watches",
          "group": "1_watch@1"
        },
        {
          "command": "serverMonitor.watch.clear",
          "when": "view == serverMonitor.watches",
          "group": "navigation@1"
        },
        {
          "command": "serverMonitor.openDashboard",
          "when": "view =~ /^serverMonitor\\./ && view != serverMonitor.gpus",
          "group": "9_global@1"
        },
        {
          "command": "serverMonitor.refresh",
          "when": "view =~ /^serverMonitor\\.(gpus|processes|tmux|ports|disks|users|docker)$/",
          "group": "9_global@2"
        },
        {
          "command": "serverMonitor.openSettings",
          "when": "view =~ /^serverMonitor\\./",
          "group": "9_global@3"
        },
        {
          "command": "serverMonitor.du.up",
          "when": "view == serverMonitor.du && serverMonitor.duHasParent",
          "group": "navigation@0"
        },
        {
          "command": "serverMonitor.freeUp",
          "when": "view == serverMonitor.processes",
          "group": "2_free@1"
        },
        {
          "command": "serverMonitor.quickCommands.run",
          "when": "view == serverMonitor.overview",
          "group": "2_tools@1"
        }
      ],
      "view/item/context": [
        {
          "command": "serverMonitor.proc.kill",
          "when": "viewItem == proc.mine",
          "group": "inline@9"
        },
        {
          "command": "serverMonitor.proc.watch",
          "when": "viewItem =~ /^proc\\./",
          "group": "1_watch@1"
        },
        {
          "command": "serverMonitor.proc.terminalAtCwd",
          "when": "viewItem == proc.mine",
          "group": "2_open@1"
        },
        {
          "command": "serverMonitor.proc.openCwd",
          "when": "viewItem == proc.mine",
          "group": "2_open@2"
        },
        {
          "command": "serverMonitor.proc.copyPid",
          "when": "viewItem =~ /^proc\\./",
          "group": "3_copy@1"
        },
        {
          "command": "serverMonitor.proc.copyCmd",
          "when": "viewItem =~ /^proc\\./",
          "group": "3_copy@2"
        },
        {
          "command": "serverMonitor.proc.interrupt",
          "when": "viewItem == proc.mine",
          "group": "9_signal@1"
        },
        {
          "command": "serverMonitor.proc.kill",
