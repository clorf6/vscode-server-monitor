        "icon": "$(list-filter)"
      },
      {
        "command": "serverMonitor.tmux.new",
        "title": "%command.tmux.new%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "serverMonitor.tmux.attach",
        "title": "%command.tmux.attach%",
        "category": "%category%",
        "icon": "$(terminal)"
      },
      {
        "command": "serverMonitor.tmux.peek",
        "title": "%command.tmux.peek%",
