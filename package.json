      },
      {
        "command": "serverMonitor.tmux.refreshPeek",
        "title": "%command.tmux.refreshPeek%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "serverMonitor.tmux.watch",
        "title": "%command.tmux.watch%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.tmux.rename",
        "title": "%command.tmux.rename%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.tmux.ctrlC",
        "title": "%command.tmux.ctrlC%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.tmux.kill",
        "title": "%command.tmux.kill%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.port.open",
        "title": "%command.port.open%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "serverMonitor.port.openInEditor",
        "title": "%command.port.openInEditor%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.port.copyUrl",
        "title": "%command.port.copyUrl%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.port.kill",
        "title": "%command.port.kill%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.disk.refresh",
        "title": "%command.disk.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "serverMonitor.disk.terminal",
        "title": "%command.disk.terminal%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.disk.copyPath",
        "title": "%command.disk.copyPath%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.docker.start",
        "title": "%command.docker.start%",
        "category": "%category%",
        "icon": "$(debug-start)"
      },
      {
        "command": "serverMonitor.docker.stop",
        "title": "%command.docker.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "serverMonitor.docker.restart",
        "title": "%command.docker.restart%",
