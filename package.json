{
  "name": "server-monitor",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "cuda",
    "disk",
    "docker",
    "gpu",
    "htop",
    "monitor",
    "nvidia",
    "nvidia-smi",
    "process",
    "remote",
    "remote-ssh",
    "server",
    "ssh",
    "tmux",
    "top",
    "wsl",
    "显卡",
    "服务器",
    "监控"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:serverMonitor.dashboard"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serverMonitor",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "serverMonitor": [
        {
          "type": "webview",
          "id": "serverMonitor.overview",
          "name": "%view.overview%",
          "icon": "$(dashboard)",
          "contextualTitle": "%viewContainer.title%"
        },
        {
          "id": "serverMonitor.gpus",
          "name": "%view.gpus%",
          "icon": "$(circuit-board)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "collapsed",
          "when": "config.serverMonitor.sidebar.showTreeViews"
        },
        {
          "id": "serverMonitor.processes",
          "name": "%view.processes%",
          "icon": "$(pulse)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "visible",
          "when": "config.serverMonitor.sidebar.showTreeViews"
        },
        {
          "id": "serverMonitor.tmux",
          "name": "%view.tmux%",
          "icon": "$(terminal-tmux)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "visible",
          "when": "config.serverMonitor.sidebar.showTreeViews"
        },
        {
          "id": "serverMonitor.ports",
          "name": "%view.ports%",
          "icon": "$(plug)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "collapsed",
          "when": "config.serverMonitor.sidebar.showTreeViews"
        },
        {
          "id": "serverMonitor.disks",
          "name": "%view.disks%",
          "icon": "$(database)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "collapsed",
          "when": "config.serverMonitor.sidebar.showTreeViews"
        },
        {
          "id": "serverMonitor.users",
          "name": "%view.users%",
          "icon": "$(organization)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "collapsed",
          "when": "config.serverMonitor.sidebar.showTreeViews"
        },
        {
          "id": "serverMonitor.docker",
          "name": "%view.docker%",
          "icon": "$(package)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "collapsed",
          "when": "config.serverMonitor.sidebar.showTreeViews && serverMonitor.dockerPresent"
        },
        {
          "id": "serverMonitor.du",
          "name": "%view.du%",
          "icon": "$(folder-library)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "collapsed",
          "when": "config.serverMonitor.sidebar.showTreeViews"
        },
        {
          "id": "serverMonitor.watches",
          "name": "%view.watches%",
          "icon": "$(bell)",
          "contextualTitle": "%viewContainer.title%",
          "visibility": "collapsed",
          "when": "config.serverMonitor.sidebar.showTreeViews"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "serverMonitor.tmux",
        "contents": "%welcome.tmux%",
        "when": "serverMonitor.tmuxInstalled"
      },
      {
        "view": "serverMonitor.du",
        "contents": "%welcome.du%"
      },
      {
        "view": "serverMonitor.watches",
        "contents": "%welcome.watches%"
      }
    ],
    "commands": [
      {
        "command": "serverMonitor.openDashboard",
        "title": "%command.openDashboard%",
        "category": "%category%",
        "icon": "$(dashboard)"
      },
      {
        "command": "serverMonitor.refresh",
        "title": "%command.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "serverMonitor.openSettings",
        "title": "%command.openSettings%",
        "category": "%category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "serverMonitor.copyFreeGpus",
        "title": "%command.copyFreeGpus%",
        "category": "%category%",
        "icon": "$(copy)"
      },
      {
        "command": "serverMonitor.pickGpus",
        "title": "%command.pickGpus%",
        "category": "%category%",
        "icon": "$(checklist)"
      },
      {
        "command": "serverMonitor.watchFreeGpus",
        "title": "%command.watchFreeGpus%",
        "category": "%category%",
        "icon": "$(bell)"
      },
      {
        "command": "serverMonitor.proc.filter",
        "title": "%command.proc.filter%",
        "category": "%category%",
        "icon": "$(filter)"
      },
      {
        "command": "serverMonitor.proc.clearFilter",
        "title": "%command.proc.clearFilter%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "serverMonitor.proc.showAll",
        "title": "%command.proc.showAll%",
        "category": "%category%",
        "icon": "$(organization)"
      },
      {
        "command": "serverMonitor.proc.showMine",
        "title": "%command.proc.showMine%",
        "category": "%category%",
        "icon": "$(account)"
      },
      {
        "command": "serverMonitor.proc.treeOn",
        "title": "%command.proc.treeOn%",
        "category": "%category%",
        "icon": "$(list-tree)"
      },
      {
        "command": "serverMonitor.proc.treeOff",
        "title": "%command.proc.treeOff%",
        "category": "%category%",
        "icon": "$(list-flat)"
      },
      {
        "command": "serverMonitor.proc.sort",
        "title": "%command.proc.sort%",
        "category": "%category%",
        "icon": "$(list-ordered)"
      },
      {
        "command": "serverMonitor.proc.showMore",
        "title": "%command.proc.showMore%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.proc.watch",
        "title": "%command.proc.watch%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.proc.terminalAtCwd",
        "title": "%command.proc.terminalAtCwd%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.proc.openCwd",
        "title": "%command.proc.openCwd%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.proc.copyPid",
        "title": "%command.proc.copyPid%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.proc.copyCmd",
        "title": "%command.proc.copyCmd%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.proc.interrupt",
        "title": "%command.proc.interrupt%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.proc.kill",
        "title": "%command.proc.kill%",
        "category": "%category%",
        "icon": "$(close)"
      },
      {
        "command": "serverMonitor.proc.kill9",
        "title": "%command.proc.kill9%",
        "category": "%category%"
      },
      {
        "command": "serverMonitor.user.showProcesses",
        "title": "%command.user.showProcesses%",
